const api = {
  baseUrl: '/api',
  token: localStorage.getItem('cmmc_token') || null,

  headers() {
    return {
      'Content-Type': 'application/json',
      ...(this.token ? { Authorization: `Bearer ${this.token}` } : {})
    };
  },

  async request(path, options = {}) {
    const response = await fetch(`${this.baseUrl}${path}`, {
      ...options,
      headers: {
        ...this.headers(),
        ...(options.headers || {})
      }
    });

    const payload = await response.json().catch(() => ({}));

    if (!response.ok) {
      throw new Error(payload.error || 'Request failed');
    }

    return payload;
  }
};

const state = {
  currentView: 'dashboard',
  assessments: [],
  evidence: [],
  poam: [],
  documents: [],
  team: [],
  connectors: []
};

function setView(viewName) {
  document.querySelectorAll('.nav-link').forEach((button) => {
    button.classList.toggle('active', button.dataset.view === viewName);
  });

  document.querySelectorAll('.view').forEach((view) => {
    view.classList.toggle('active', view.id === `view-${viewName}`);
  });

  state.currentView = viewName;
}

function authRequired() {
  return !api.token;
}

function updateAuthUI() {
  const isLoggedIn = !!api.token;
  document.getElementById('authPanel').classList.toggle('hidden', isLoggedIn);
  document.querySelector('.main').style.filter = isLoggedIn ? 'none' : 'brightness(0.85)';
}

function renderStatusSummary(items) {
  const summary = document.getElementById('statusSummary');
  if (!items || items.length === 0) {
    summary.innerHTML = '<p class="muted">No statuses yet.</p>';
    return;
  }

  const counts = items.reduce((acc, item) => {
    acc[item.source] = (acc[item.source] || 0) + 1;
    return acc;
  }, {});

  summary.innerHTML = Object.entries(counts).map(([source, count]) => {
    return `<span class="status-pill ${source}">${source} • ${count}</span>`;
  }).join('');
}

async function loadDashboard() {
  try {
    const assessments = await api.request('/assessments');
    const poam = await api.request('/poam');
    const documents = await api.request('/documents');

    state.assessments = assessments.assessments || [];
    state.poam = poam.poamItems || [];
    state.documents = documents.documents || [];

    document.getElementById('assessmentCount').textContent = String(state.assessments.length);
    document.getElementById('poamCount').textContent = String(state.poam.length);
    document.getElementById('documentCount').textContent = String(state.documents.length);
    document.getElementById('readinessScore').textContent = `${Math.min(100, Math.round((state.assessments.length || 0) * 25))}%`;

    const statuses = [];
    for (const assessment of state.assessments) {
      const details = await api.request(`/assessments/${assessment.id}`);
      statuses.push(...(details.practices || []));
    }

    renderStatusSummary(statuses);
  } catch (error) {
    console.warn('Dashboard load skipped:', error.message);
  }
}

async function loadAssessments() {
  try {
    const data = await api.request('/assessments');
    state.assessments = data.assessments || [];

    const list = document.getElementById('assessmentList');
    list.innerHTML = state.assessments.length
      ? state.assessments.map((assessment) => `
        <div class="list-item">
          <h4>${assessment.name}</h4>
          <p>Status: ${assessment.status}</p>
        </div>
      `).join('')
      : '<div class="list-item"><p>No assessments yet.</p></div>';
  } catch (error) {
    console.error(error);
  }
}

