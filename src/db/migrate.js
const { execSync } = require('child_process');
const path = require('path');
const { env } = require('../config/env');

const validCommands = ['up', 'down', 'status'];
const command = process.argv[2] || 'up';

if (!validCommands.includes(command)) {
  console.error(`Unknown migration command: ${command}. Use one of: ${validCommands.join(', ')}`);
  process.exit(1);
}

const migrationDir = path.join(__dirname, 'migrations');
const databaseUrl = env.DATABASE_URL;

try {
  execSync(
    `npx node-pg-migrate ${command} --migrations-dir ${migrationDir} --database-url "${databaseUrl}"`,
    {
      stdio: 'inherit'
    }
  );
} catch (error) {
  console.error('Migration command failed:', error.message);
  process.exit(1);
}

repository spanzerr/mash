document.getElementById('generateDocButton').addEventListener('click', async () => {
  try {
    const assessments = await api.request('/assessments');
    const firstAssessment = assessments.assessments?.[0];
    if (!firstAssessment) {
      alert('Create an assessment before generating a document.');
      return;
    }

    await api.request('/documents/generate', {
      method: 'POST',
      body: JSON.stringify({ assessmentId: firstAssessment.id, documentType: 'ssp' })
    });
    await refreshAll();
  } catch (error) {
    alert(error.message);
  }
});

