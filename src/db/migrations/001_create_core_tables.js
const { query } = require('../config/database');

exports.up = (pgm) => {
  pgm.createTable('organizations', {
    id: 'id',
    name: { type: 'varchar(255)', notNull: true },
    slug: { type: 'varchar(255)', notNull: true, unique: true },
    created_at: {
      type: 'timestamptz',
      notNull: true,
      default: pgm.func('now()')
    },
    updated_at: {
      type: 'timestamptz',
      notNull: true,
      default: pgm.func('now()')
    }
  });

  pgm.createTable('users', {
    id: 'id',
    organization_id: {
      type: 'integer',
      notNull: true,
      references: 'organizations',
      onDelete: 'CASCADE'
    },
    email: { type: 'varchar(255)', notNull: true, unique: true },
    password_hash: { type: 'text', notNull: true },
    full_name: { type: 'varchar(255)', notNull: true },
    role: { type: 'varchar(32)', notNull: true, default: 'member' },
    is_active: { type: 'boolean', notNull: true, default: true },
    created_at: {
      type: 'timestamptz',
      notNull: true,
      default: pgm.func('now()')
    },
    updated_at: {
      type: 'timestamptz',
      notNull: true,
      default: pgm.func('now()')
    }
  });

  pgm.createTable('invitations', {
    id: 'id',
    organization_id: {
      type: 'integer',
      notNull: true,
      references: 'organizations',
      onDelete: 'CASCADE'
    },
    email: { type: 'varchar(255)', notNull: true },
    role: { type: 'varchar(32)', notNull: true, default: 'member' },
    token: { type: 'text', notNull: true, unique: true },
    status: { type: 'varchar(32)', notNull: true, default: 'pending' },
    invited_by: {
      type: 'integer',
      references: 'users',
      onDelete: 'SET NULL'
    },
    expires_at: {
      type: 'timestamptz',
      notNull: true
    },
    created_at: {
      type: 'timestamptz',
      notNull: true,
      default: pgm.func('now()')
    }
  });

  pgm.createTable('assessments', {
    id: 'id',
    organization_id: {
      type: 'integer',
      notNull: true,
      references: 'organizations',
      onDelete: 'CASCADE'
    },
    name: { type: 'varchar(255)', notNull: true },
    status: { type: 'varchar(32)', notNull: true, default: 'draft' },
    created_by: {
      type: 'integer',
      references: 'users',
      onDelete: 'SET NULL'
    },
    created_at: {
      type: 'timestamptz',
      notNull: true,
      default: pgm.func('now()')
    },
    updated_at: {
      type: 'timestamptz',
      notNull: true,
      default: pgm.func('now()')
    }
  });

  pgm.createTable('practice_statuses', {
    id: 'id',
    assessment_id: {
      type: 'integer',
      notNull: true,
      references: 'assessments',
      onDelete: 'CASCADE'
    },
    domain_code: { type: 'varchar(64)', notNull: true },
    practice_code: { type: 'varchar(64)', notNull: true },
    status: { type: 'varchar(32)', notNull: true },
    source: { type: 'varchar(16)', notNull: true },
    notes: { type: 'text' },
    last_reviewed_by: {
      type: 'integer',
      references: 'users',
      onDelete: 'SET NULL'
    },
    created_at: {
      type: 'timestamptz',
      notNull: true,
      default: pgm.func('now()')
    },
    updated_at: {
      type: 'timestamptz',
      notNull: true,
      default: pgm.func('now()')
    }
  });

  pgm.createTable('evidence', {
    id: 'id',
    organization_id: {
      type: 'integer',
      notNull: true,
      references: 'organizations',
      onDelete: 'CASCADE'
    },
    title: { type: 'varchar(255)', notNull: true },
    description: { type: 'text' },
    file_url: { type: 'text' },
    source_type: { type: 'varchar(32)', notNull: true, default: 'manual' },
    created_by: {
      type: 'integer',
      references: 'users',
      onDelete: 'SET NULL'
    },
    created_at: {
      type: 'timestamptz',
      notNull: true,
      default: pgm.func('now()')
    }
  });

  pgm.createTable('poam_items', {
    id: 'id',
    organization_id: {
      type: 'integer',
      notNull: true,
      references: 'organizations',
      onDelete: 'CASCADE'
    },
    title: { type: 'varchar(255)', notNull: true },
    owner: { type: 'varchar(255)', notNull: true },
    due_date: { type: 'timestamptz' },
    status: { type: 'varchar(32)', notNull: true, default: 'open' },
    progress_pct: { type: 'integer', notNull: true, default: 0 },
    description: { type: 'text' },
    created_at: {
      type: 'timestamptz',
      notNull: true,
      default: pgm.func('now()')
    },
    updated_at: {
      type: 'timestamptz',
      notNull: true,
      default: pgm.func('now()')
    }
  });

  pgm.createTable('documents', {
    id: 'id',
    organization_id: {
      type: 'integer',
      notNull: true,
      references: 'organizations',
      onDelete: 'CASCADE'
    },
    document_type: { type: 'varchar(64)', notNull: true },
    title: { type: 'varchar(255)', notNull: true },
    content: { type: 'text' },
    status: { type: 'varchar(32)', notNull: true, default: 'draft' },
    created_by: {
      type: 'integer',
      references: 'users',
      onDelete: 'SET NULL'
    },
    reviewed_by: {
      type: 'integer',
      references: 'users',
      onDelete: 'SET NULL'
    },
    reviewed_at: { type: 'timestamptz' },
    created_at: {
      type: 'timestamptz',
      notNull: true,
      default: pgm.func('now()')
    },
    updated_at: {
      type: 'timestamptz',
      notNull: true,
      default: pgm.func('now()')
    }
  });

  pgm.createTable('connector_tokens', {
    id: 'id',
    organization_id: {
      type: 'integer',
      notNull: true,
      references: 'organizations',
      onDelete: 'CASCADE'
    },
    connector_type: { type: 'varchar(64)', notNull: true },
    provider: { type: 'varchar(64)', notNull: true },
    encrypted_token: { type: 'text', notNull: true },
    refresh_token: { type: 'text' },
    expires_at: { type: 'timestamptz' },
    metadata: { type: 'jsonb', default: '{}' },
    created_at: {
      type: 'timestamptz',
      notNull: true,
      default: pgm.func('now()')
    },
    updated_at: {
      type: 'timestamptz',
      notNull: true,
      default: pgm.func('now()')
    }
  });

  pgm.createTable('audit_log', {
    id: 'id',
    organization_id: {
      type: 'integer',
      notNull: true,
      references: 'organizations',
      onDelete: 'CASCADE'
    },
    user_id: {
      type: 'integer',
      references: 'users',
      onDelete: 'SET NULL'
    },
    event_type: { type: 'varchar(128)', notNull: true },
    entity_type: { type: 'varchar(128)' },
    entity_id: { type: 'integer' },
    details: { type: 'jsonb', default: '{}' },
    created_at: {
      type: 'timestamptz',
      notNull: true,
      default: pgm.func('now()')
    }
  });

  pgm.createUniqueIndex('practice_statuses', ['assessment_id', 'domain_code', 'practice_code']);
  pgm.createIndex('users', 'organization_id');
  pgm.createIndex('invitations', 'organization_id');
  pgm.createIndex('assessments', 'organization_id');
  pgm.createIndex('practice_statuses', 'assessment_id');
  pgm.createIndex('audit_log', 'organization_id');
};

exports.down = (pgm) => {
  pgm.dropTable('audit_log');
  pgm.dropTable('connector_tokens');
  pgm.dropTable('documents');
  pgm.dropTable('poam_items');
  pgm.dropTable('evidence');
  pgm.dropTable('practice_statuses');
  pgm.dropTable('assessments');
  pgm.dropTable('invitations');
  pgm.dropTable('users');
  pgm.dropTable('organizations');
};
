const { query } = require('../config/database');

function normalizeStatus(status) {
  const value = String(status || '').toLowerCase();
  const valid = ['not_started', 'in_progress', 'complete', 'partial', 'needs_attention'];
  return valid.includes(value) ? value : 'not_started';
}

