async function ensureAssessmentPractices(assessmentId) {
  const existing = await query(
    `SELECT * FROM practice_statuses WHERE assessment_id = $1 LIMIT 1`,
    [assessmentId]
  );

  if (existing.rows.length > 0) {
    return existing.rows;
  }

  const inserts = DEFAULT_PRACTICES.map((p) => {
    return `($1, $2, $3, 'not_started', 'manual', $4, NULL, NOW(), NOW())`;
  }).join(', ');

  const params = [];
  for (const p of DEFAULT_PRACTICES) {
    params.push(assessmentId, p.domainCode, p.practiceCode, p.title);
  }

  await query(
    `INSERT INTO practice_statuses (assessment_id, domain_code, practice_code, status, source, notes, last_reviewed_by, created_at, updated_at)
     VALUES ${inserts}`,
    params
  );

  const refreshed = await query(
    `SELECT * FROM practice_statuses WHERE assessment_id = $1 ORDER BY domain_code, practice_code`,
    [assessmentId]
  );

  return refreshed.rows;
}

function assessSourceIntegrity(existingEntry, incomingSource) {
  if (!existingEntry) {
    return incomingSource || 'manual';
  }

  if (['connector', 'manual'].includes(existingEntry.source) && incomingSource === 'ai') {
    return existingEntry.source;
  }

  return incomingSource || existingEntry.source || 'manual';
}

async function updatePracticeStatus({ assessmentId, domainCode, practiceCode, status, source, notes, userId }) {
  const normalizedStatus = normalizeStatus(status);
  const { rows } = await query(
    `SELECT * FROM practice_statuses WHERE assessment_id = $1 AND domain_code = $2 AND practice_code = $3 LIMIT 1`,
    [assessmentId, domainCode, practiceCode]
  );

  const existing = rows[0];
  const finalSource = assessSourceIntegrity(existing, source);

  const result = await query(
    `INSERT INTO practice_statuses (assessment_id, domain_code, practice_code, status, source, notes, last_reviewed_by, created_at, updated_at)
     VALUES ($1, $2, $3, $4, $5, $6, $7, NOW(), NOW())
     ON CONFLICT (assessment_id, domain_code, practice_code)
     DO UPDATE SET status = EXCLUDED.status, source = EXCLUDED.source, notes = EXCLUDED.notes, last_reviewed_by = EXCLUDED.last_reviewed_by, updated_at = NOW()`,
    [assessmentId, domainCode, practiceCode, normalizedStatus, finalSource, notes || existing?.notes || null, userId || existing?.last_reviewed_by || null]
  );

  const refreshed = await query(
    `SELECT * FROM practice_statuses WHERE assessment_id = $1 AND domain_code = $2 AND practice_code = $3 LIMIT 1`,
    [assessmentId, domainCode, practiceCode]
  );

  return refreshed.rows[0];
}

