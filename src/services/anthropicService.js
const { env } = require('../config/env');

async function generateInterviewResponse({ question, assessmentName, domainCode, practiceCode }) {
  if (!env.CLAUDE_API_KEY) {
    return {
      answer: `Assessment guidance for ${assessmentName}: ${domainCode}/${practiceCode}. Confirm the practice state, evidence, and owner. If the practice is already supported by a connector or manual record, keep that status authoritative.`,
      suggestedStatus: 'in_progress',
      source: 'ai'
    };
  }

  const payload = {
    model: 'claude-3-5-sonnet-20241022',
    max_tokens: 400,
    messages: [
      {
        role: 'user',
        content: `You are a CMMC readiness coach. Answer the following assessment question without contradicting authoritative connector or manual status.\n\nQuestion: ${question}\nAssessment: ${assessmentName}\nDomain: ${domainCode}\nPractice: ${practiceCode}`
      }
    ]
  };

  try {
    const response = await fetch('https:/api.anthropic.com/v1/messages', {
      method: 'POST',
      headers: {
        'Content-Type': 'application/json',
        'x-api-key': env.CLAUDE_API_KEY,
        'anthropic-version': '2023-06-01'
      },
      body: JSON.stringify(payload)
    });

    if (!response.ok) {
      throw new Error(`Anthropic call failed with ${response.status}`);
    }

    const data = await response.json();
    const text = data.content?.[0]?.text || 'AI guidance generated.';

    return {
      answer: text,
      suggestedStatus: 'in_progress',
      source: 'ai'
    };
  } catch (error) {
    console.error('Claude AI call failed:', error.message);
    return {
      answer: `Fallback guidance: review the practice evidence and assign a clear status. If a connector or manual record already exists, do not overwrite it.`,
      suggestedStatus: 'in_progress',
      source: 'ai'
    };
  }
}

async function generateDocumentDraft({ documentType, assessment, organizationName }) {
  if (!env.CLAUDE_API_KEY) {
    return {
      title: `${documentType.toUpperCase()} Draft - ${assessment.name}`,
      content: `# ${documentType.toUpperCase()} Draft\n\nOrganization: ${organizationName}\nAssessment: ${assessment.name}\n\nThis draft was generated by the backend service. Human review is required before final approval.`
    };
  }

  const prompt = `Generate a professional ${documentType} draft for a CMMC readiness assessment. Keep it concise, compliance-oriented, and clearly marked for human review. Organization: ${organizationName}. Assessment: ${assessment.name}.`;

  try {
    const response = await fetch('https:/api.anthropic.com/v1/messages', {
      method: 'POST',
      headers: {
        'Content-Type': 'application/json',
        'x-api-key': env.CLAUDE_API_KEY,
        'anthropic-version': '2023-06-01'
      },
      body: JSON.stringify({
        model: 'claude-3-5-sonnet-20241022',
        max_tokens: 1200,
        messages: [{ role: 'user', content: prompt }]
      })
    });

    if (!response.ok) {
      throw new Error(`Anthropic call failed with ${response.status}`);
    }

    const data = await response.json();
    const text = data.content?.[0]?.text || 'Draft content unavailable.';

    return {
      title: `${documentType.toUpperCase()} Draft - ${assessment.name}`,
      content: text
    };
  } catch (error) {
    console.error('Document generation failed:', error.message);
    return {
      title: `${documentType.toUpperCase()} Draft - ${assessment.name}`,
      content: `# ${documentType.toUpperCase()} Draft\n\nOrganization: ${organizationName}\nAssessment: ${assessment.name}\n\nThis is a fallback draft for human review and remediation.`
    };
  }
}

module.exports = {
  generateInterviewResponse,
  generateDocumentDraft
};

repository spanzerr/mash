async function ensureAssessmentPractices(assessmentId) {
  const { rows } = await query(
    `SELECT * FROM practice_statuses WHERE assessment_id = $1 LIMIT 1`,
    [assessmentId]
  );

  if (rows.length > 0) {
    return rows;
  }

  const values = DEFAULT_PRACTICES.map((practice, index) => {
    return `($1, $2, $3, $4, $5, $6, $7, NOW(), NOW())`;
  }).join(', ');

  const params = [];
  DEFAULT_PRACTICES.forEach((practice) => {
    params.push(
      assessmentId,
      practice.domainCode,
      practice.practiceCode,
      'not_started',
      practice.source,
      practice.title,
      null
    );
  });

  await query(
    `INSERT INTO practice_statuses (assessment_id, domain_code, practice_code, status, source, notes, last_reviewed_by, created_at, updated_at)
     VALUES ${values}`,
    params
  );

  const refreshed = await query(
    `SELECT * FROM practice_statuses WHERE assessment_id = $1 ORDER BY domain_code, practice_code`,
    [assessmentId]
  );

  return refreshed.rows;
}

function assessSourceIntegrity(currentEntry, incomingSource) {
  if (!currentEntry) {
    return incomingSource || 'manual';
  }

  const protectedSources = ['connector', 'manual'];
  if (protectedSources.includes(currentEntry.source) && incomingSource === 'ai') {
    return currentEntry.source;
  }

  return incomingSource || currentEntry.source || 'manual';
}

async function updatePracticeStatus({ assessmentId, domainCode, practiceCode, status, source, notes, userId }) {
  const { rows } = await query(
    `SELECT * FROM practice_statuses WHERE assessment_id = $1 AND domain_code = $2 AND practice_code = $3 LIMIT 1`,
    [assessmentId, domainCode, practiceCode]
  );

  const existing = rows[0];
  const finalSource = assessSourceIntegrity(existing, source);

  if (existing && finalSource !== existing.source) {
    const preservedStatus = existing.status;
    const preservedNotes = existing.notes;

    if (source === 'ai' && ['connector', 'manual'].includes(existing.source)) {
      return {
        ...existing,
        status: preservedStatus,
        notes: preservedNotes,
        source: existing.source,
        skipped: true,
        message: 'AI update blocked because a higher-priority source already exists.'
      };
    }
  }

  const nextStatus = status || existing?.status || 'not_started';
  const nextNotes = notes || existing?.notes || null;

  const result = await query(
    `INSERT INTO practice_statuses (assessment_id, domain_code, practice_code, status, source, notes, last_reviewed_by, created_at, updated_at)
     VALUES ($1, $2, $3, $4, $5, $6, $7, NOW(), NOW())
     ON CONFLICT (assessment_id, domain_code, practice_code)
     DO UPDATE SET status = EXCLUDED.status, source = EXCLUDED.source, notes = EXCLUDED.notes, last_reviewed_by = EXCLUDED.last_reviewed_by, updated_at = NOW()`,
    [assessmentId, domainCode, practiceCode, nextStatus, finalSource, nextNotes, userId]
  );

  const refreshed = await query(
    `SELECT * FROM practice_statuses WHERE assessment_id = $1 AND domain_code = $2 AND practice_code = $3 LIMIT 1`,
    [assessmentId, domainCode, practiceCode]
  );

  return refreshed.rows[0];
}

